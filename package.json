{
  "name": "the-draw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/bootstrap.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/bootstrap.ts",
    "preview": "npm run build && npm start",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "draw:operations": "tsx scripts/draw-operations.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "camera-controls": "^3.1.2",
    "compression": "^1.8.1",
    "d3-hierarchy": "^3.1.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "gsap": "^3.13.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.5",
    "postprocessing": "^6.39.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.171.0",
    "troika-three-text": "^0.52.5",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.28.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "flag-icons": "^7.5.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}

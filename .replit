run = "npm run dev"
entrypoint = "server/bootstrap.ts"
modules = ["nodejs-20", "web", "python-3.12", "postgresql-16"]

[nix]
channel = "stable-25_05"

# The Draw is a single self-contained Express + Postgres app. MediaWiki
# polling, reconciliation, and email/retention maintenance all run in-process
# on a fixed interval (see server/draw-ingestion.ts), so this must deploy to
# a Reserved VM (always-on), not autoscale or static: an autoscaled instance
# can be spun down between requests and would silently stop polling, and a
# static target has no server at all.
[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm start"]
healthCheckPath = "/api/ready"

[env]
PORT = "3000"
# DRAW_LEAGUE_MUTATIONS_ENABLED and DRAW_RETENTION_WORKER_ENABLED are booleans with no other
# required config, so they are safe to commit here (unlike DATABASE_URL/PUBLIC_URL/
# SESSION_SECRET/DRAW_SOURCE_USER_AGENT, which stay Replit Secrets). DRAW_SOURCE_WORKER_ENABLED
# also stays a Replit Secret alongside DRAW_SOURCE_USER_AGENT (its required, operator-specific
# MediaWiki contact string) — server/env.ts fails the production boot fast with a clear error if
# either DRAW_SOURCE_WORKER_ENABLED or DRAW_RETENTION_WORKER_ENABLED is left unset, so a redeploy
# can no longer silently ship with polling or retention turned off.
DRAW_LEAGUE_MUTATIONS_ENABLED = "true"
DRAW_RETENTION_WORKER_ENABLED = "true"

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Dev"

[[workflows.workflow]]
name = "Dev"
author = "andrey"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 3000
